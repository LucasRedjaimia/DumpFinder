<!-- Tools, same layout as Windows (src/UI/MainWindow.WinToolsPage.cs, Hosting.cs, HistoryPage.cs):
     macOS tools (4 category cards of 2 launcher tiles) | Report & export (buttons + plain-text report) | History
     (stability trend + last 8 days, change journal). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DumpFinder.Mac"
             x:Class="DumpFinder.Mac.Pages.ToolsPage"
             x:DataType="local:MainViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding L[main_window.tools]}" />
        <TextBlock Classes="subtitle" Text="{Binding L[hosting.the_windows_utilities_that_help_diagnose]}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="segment" Classes.active="{Binding IsToolsApps}" Content="{Binding L[hosting.windows_tools]}" Command="{Binding ToolsTabCommand}" CommandParameter="0" />
        <Button Classes="segment" Classes.active="{Binding IsToolsReport}" Content="{Binding L[hosting.report_export]}" Command="{Binding ToolsTabCommand}" CommandParameter="1" />
        <Button Classes="segment" Classes.active="{Binding IsToolsHistory}" Content="{Binding L[crashes.history]}" Command="{Binding ToolsTabCommand}" CommandParameter="2" />
      </StackPanel>
    </Grid>

    <!-- macOS tools -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsToolsApps}">
      <ItemsControl ItemsSource="{Binding ToolCategories}" Margin="0,0,6,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ToolCategory">
            <Border Classes="card" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                  <PathIcon Data="{Binding Icon, Converter={StaticResource Icon}}" Width="15" Height="15" Foreground="{DynamicResource AccentText}" />
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolItem">
                      <Border Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,10,8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="flat accenttext" VerticalAlignment="Center"
                                  Content="{Binding $parent[UserControl].((local:MainViewModel)DataContext).L[win_tools.launch]}"
                                  Command="{Binding $parent[UserControl].((local:MainViewModel)DataContext).LaunchToolCommand}" CommandParameter="{Binding}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Report & export -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsToolsReport}" Margin="0,0,6,16">
      <WrapPanel Margin="0,0,0,12">
        <Button Classes="primary" Height="34" Padding="16,7" Margin="0,0,8,8" Command="{Binding ExportHtmlCommand}"
                ToolTip.Tip="{Binding L[reports.a_standalone_page_readable_in_any]}">
          <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource Icon.Document}" /><TextBlock Text="{Binding L[reports.html_report]}" /></StackPanel>
        </Button>
        <Button Classes="flat" Height="34" Margin="0,0,8,8" Command="{Binding ExportJsonCommand}">
          <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource Icon.Save}" /><TextBlock Text="{Binding L[reports.json]}" /></StackPanel>
        </Button>
        <Button Classes="flat" Height="34" Margin="0,0,8,8" Command="{Binding CopyMarkdownCommand}" ToolTip.Tip="{Binding L[reports.summary_ready_to_paste_on_reddit]}">
          <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource Icon.Copy}" /><TextBlock Text="{Binding L[reports.markdown_forum]}" /></StackPanel>
        </Button>
        <Button Classes="flat" Height="34" Margin="0,0,8,8" Command="{Binding CopyTextCommand}">
          <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource Icon.Copy}" /><TextBlock Text="{Binding L[reports.plain_text]}" /></StackPanel>
        </Button>
        <Button Classes="flat" Height="34" Margin="0,0,8,8" Command="{Binding SaveTextCommand}">
          <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource Icon.Save}" /><TextBlock Text="{Binding L[main_window.save_txt]}" /></StackPanel>
        </Button>
      </WrapPanel>
      <Border Grid.Row="1" Classes="card" Padding="0">
        <TextBox Text="{Binding ReportText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Classes="report"
                 FontFamily="Menlo, Monaco, monospace" FontSize="12" Padding="16" BorderThickness="0" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Border>
    </Grid>

    <!-- History -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsToolsHistory}">
      <StackPanel Margin="0,0,6,16">
        <Border Classes="card" Padding="18,14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Classes="section" Text="{Binding L[history.stability_over_time]}" HorizontalAlignment="Left" />
            <TextBlock Classes="body" Text="{Binding TrendSummary}" Margin="0,6,0,0" />
            <local:Sparkline Values="{Binding Trend}" Height="56" Margin="0,12,0,4" IsVisible="{Binding HasTrend}" LineBrush="{DynamicResource AccentText}" />
            <ItemsControl ItemsSource="{Binding HistoryRows}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryRow">
                  <Grid ColumnDefinitions="130,Auto,*" Margin="0,4">
                    <TextBlock Text="{Binding Date}" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="pill" Classes.success="{Binding IsSuccess}" Classes.warn="{Binding IsWarn}" Classes.danger="{Binding IsDanger}"><TextBlock Text="{Binding Score}" /></Border>
                    <TextBlock Grid.Column="2" Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="18,14,18,10">
          <StackPanel>
            <TextBlock Classes="section" Text="{Binding L[history.change_journal]}" HorizontalAlignment="Left" />
            <TextBlock Classes="body" Text="{Binding L[history.every_fix_records_the_exact_value]}" Margin="0,6,0,10" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,6">
              <PathIcon Data="{StaticResource Icon.Lightbulb}" Width="16" Height="16" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Text="{Binding L[history.no_changes_yet_applied_fixes_will]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
