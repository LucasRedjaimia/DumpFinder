<!-- Hardware: check cards in the Windows style (level pill, tag, title, detail, advice), this Mac, extensions.
     The Windows sub-tabs (Hardware / Conflicts / Drivers / Stability test) come with the next steps. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DumpFinder.Mac"
             x:Class="DumpFinder.Mac.Pages.HardwarePage"
             x:DataType="local:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="0,0,6,16">
      <TextBlock Classes="title" Text="{Binding L[main_window.hardware]}" />
      <TextBlock Classes="subtitle" Text="{Binding L[mac.hardware.subtitle]}" Margin="0,2,0,16" />

      <TextBlock Classes="section" Text="{Binding L[mac.home.checks]}" Margin="2,0,0,8" />
      <ItemsControl ItemsSource="{Binding Checks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:CheckCard">
            <Border Classes="card" Padding="18,14" Margin="0,0,0,10">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="pill" Classes.danger="{Binding IsDanger}" Classes.warn="{Binding IsWarn}" Classes.success="{Binding IsSuccess}" Classes.accent="{Binding IsAccent}">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                  <TextBlock Classes="caption" Text="{Binding Category}" VerticalAlignment="Center" />
                </StackPanel>
                <SelectableTextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                <SelectableTextBlock Classes="body" Text="{Binding Detail}" />
                <Border Background="{DynamicResource BgSubtle}" CornerRadius="8" Padding="12,8" Margin="0,6,0,0" IsVisible="{Binding HasAdvice}">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource Icon.Lightbulb}" Width="14" Height="14" Foreground="{DynamicResource AccentText}" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <SelectableTextBlock Grid.Column="1" Classes="body" Text="{Binding Advice}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="section" Text="{Binding L[mac.hardware.this_mac]}" Margin="2,10,0,8" />
      <Border Classes="card" Padding="18,4" Margin="0,0,0,16">
        <ItemsControl ItemsSource="{Binding Machine}" ItemTemplate="{StaticResource InfoRowTemplate}" />
      </Border>

      <TextBlock Classes="section" Text="{Binding L[mac.hardware.extensions]}" Margin="2,0,0,8" />
      <Border Classes="card" Padding="18,4">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Extensions}" ItemTemplate="{StaticResource InfoRowTemplate}" />
          <TextBlock Classes="body" Text="{Binding L[mac.hardware.no_extension]}" Margin="0,12" IsVisible="{Binding NoExtension}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
