<!-- Settings, same layout as Windows (src/UI/MainWindow.SettingsPage.cs): section header, card of rows
     (icon · title + description · control). Monitoring, AI, Integrations and Help come with the next steps. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DumpFinder.Mac"
             x:Class="DumpFinder.Mac.Pages.SettingsPage"
             x:DataType="local:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="0,0,6,0" MaxWidth="920" HorizontalAlignment="Left">
      <TextBlock Classes="title" Text="{Binding L[main_window.settings]}" Margin="0,0,0,18" />

      <TextBlock Text="{Binding L[settings.general]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,8" />
      <Border Classes="card" Padding="0" Margin="0,0,0,18">
        <StackPanel>
          <Border Classes="setting first">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Globe}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Classes="strong" Text="{Binding L[settings.language]}" />
                <TextBlock Text="{Binding L[settings.language_of_the_interface_and_explanatio]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="2" Width="220" VerticalAlignment="Center" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}"
                        AutomationProperties.Name="{Binding L[settings.language]}" />
            </Grid>
          </Border>
          <Border Classes="setting">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Lightbulb}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Classes="strong" Text="{Binding L[settings.appearance]}" />
                <TextBlock Text="{Binding L[settings.follow_windows_or_force_light_or]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="2" Width="220" VerticalAlignment="Center" ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}"
                        AutomationProperties.Name="{Binding L[settings.appearance]}" />
            </Grid>
          </Border>
          <Border Classes="setting">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Refresh}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Classes="strong" Text="{Binding L[updates.updates]}" />
                <TextBlock Text="{Binding UpdateSettingText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="flat" Content="{Binding L[updates.check_now]}" Command="{Binding CheckUpdateNowCommand}" />
                <Button Classes="flat toggle" Classes.on="{Binding UpdateCheckOn}" MinWidth="120" Content="{Binding UpdateToggleText}" Command="{Binding ToggleUpdateCheckCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="setting">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Lightbulb}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Classes="strong" Text="{Binding L[settings.app_introduction]}" />
                <TextBlock Text="{Binding L[settings.replay_the_three_welcome_screens_and]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="2" Classes="flat" VerticalAlignment="Center" Content="{Binding L[settings.replay_introduction]}" Command="{Binding ReplayIntroCommand}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Monitoring (Windows: Sentinel + start with Windows) -->
      <TextBlock Text="{Binding L[settings.monitoring]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,8" />
      <Border Classes="card" Padding="0" Margin="0,0,0,18">
        <StackPanel>
          <Border Classes="setting first">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Shield}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Classes="strong" Text="{Binding L[settings.sentinel]}" />
                <TextBlock Text="{Binding L[settings.stays_in_the_notification_area_and]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="2" Classes="flat toggle" Classes.on="{Binding SentinelOn}" MinWidth="180" VerticalAlignment="Center"
                      Content="{Binding SentinelLabel}" Command="{Binding ToggleSentinelCommand}" />
            </Grid>
          </Border>
          <Border Classes="setting">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Lightning}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Classes="strong" Text="{Binding L[sentinel.start_with_windows]}" />
                <TextBlock Text="{Binding L[sentinel.starts_the_sentinel_at_sign_in]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="2" Classes="flat toggle" Classes.on="{Binding LoginOn}" MinWidth="180" VerticalAlignment="Center"
                      Content="{Binding LoginLabel}" Command="{Binding ToggleLoginCommand}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- AI assistant (Windows provider card): provider + Claude model | key or Ollama model | Copy prompt -->
      <TextBlock Text="{Binding L[settings.ai_assistant]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,4" />
      <TextBlock Text="{Binding L[settings.used_by_ask_the_ai_on]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="2,0,0,10" />
      <Border Classes="card" Padding="18,14,18,16" Margin="0,0,0,18">
        <Grid ColumnDefinitions="225,12,*,12,Auto">
          <StackPanel>
            <TextBlock Text="{Binding L[ai.ai_provider]}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="2,0,0,4" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AiProviders}" SelectedIndex="{Binding AiProviderIndex}" AutomationProperties.Name="{Binding L[ai.ai_provider]}" />
            <ComboBox HorizontalAlignment="Stretch" Margin="0,8,0,0" ItemsSource="{Binding ClaudeModelNames}" SelectedIndex="{Binding ClaudeModelIndex}"
                      IsVisible="{Binding IsClaude}" AutomationProperties.Name="{Binding L[ai.claude_model]}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{Binding AiCredentialCaption}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="2,0,0,4" />
            <TextBox PasswordChar="•" RevealPassword="False" Text="{Binding ApiKey}" IsVisible="{Binding NeedsKey}" AutomationProperties.Name="{Binding AiCredentialCaption}" />
            <TextBox Text="{Binding OllamaModel}" IsVisible="{Binding IsOllama}" AutomationProperties.Name="{Binding AiCredentialCaption}" />
          </StackPanel>
          <Button Grid.Column="4" Classes="flat accenttext" VerticalAlignment="Bottom" Command="{Binding CopyAiPromptCommand}">
            <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource Icon.Copy}" /><TextBlock Text="{Binding L[ai.copy_prompt]}" /></StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Integrations (Windows MCP card): status badge, description, configuration preview, enable / copy buttons -->
      <TextBlock Text="{Binding L[settings.integrations]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,8" />
      <Border Classes="card" Padding="18,16" Margin="0,0,0,22">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="{Binding L[ai.mcp_server_antigravity_claude_code_gemin]}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Border Grid.Column="1" Classes="pill" Classes.success="{Binding McpRegistered}" Padding="10,3"><TextBlock Text="{Binding McpStatus}" /></Border>
          </Grid>
          <TextBlock Text="{Binding L[ai.dump_finder_embeds_a_model_context]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
            <SelectableTextBlock Text="{Binding McpPreview}" FontFamily="Menlo, monospace" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
          </Border>
          <WrapPanel>
            <Button Classes="primary" Margin="0,0,8,6" Content="{Binding L[ai.enable_in_claude_desktop]}" Command="{Binding RegisterClaudeDesktopCommand}" />
            <Button Classes="primary" Margin="0,0,8,6" Content="{Binding L[ai.enable_in_antigravity]}" Command="{Binding RegisterAntigravityCommand}" />
            <Button Classes="flat" Margin="0,0,8,6" Content="{Binding L[ai.copy_claude_code_command]}" Command="{Binding CopyClaudeCodeCommand}" />
            <Button Classes="flat" Margin="0,0,0,6" Content="{Binding L[ai.copy_gemini_cli_command]}" Command="{Binding CopyGeminiCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding L[mac.settings.about]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,8" />
      <Border Classes="card" Padding="0" Margin="0,0,0,24">
        <Border Classes="setting first">
          <Grid ColumnDefinitions="Auto,*">
            <Image Source="{StaticResource BrandLogo}" Width="28" Height="28" Margin="0,0,14,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="strong" Text="Dump Finder" />
              <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
