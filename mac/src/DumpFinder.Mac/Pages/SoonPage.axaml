<!-- Fixes, Optimize and Tools: present in the sidebar like on Windows, filled in by the next steps of the Mac port. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DumpFinder.Mac"
             x:Class="DumpFinder.Mac.Pages.SoonPage"
             x:DataType="local:MainViewModel">
  <StackPanel>
    <TextBlock Classes="title" Text="{Binding SoonTitle}" Margin="0,0,0,18" />
    <Border Classes="card" Padding="24,22" MaxWidth="720" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="Auto,*">
        <Border Classes="tile" Width="40" Height="40" CornerRadius="11">
          <PathIcon Data="{StaticResource Icon.Lightbulb}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Classes="section" Text="{Binding L[mac.soon.title]}" />
          <TextBlock Classes="body" Text="{Binding L[mac.soon.body]}" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
