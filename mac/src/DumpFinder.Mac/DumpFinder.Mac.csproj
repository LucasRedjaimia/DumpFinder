<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DumpFinder.Mac</RootNamespace>
    <AssemblyName>DumpFinder</AssemblyName>
    <Version>0.1.0</Version>
    <!-- Apple Silicon only, like the Windows build is x64 only. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.21" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.21" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.21" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DumpFinder.Mac.Core\DumpFinder.Mac.Core.csproj" />
  </ItemGroup>

</Project>
