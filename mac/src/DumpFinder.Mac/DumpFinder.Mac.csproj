<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DumpFinder.Mac</RootNamespace>
    <AssemblyName>DumpFinder</AssemblyName>
    <Version>0.1.0</Version>
    <!-- Apple Silicon only, like the Windows build is x64 only. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.21" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.21" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DumpFinder.Mac.Core\DumpFinder.Mac.Core.csproj" />
  </ItemGroup>

  <!-- GPU stage of the stability test: a Metal helper (mac/native/gpu-stress.swift) built with swiftc and shipped next to
       the app binary, in the build output and in the published bundle. -->
  <PropertyGroup>
    <GpuStressSource>$(MSBuildThisFileDirectory)..\..\native\gpu-stress.swift</GpuStressSource>
    <GpuStressBinary>$(IntermediateOutputPath)gpu-stress</GpuStressBinary>
  </PropertyGroup>
  <Target Name="BuildGpuStress" BeforeTargets="AssignTargetPaths" Inputs="$(GpuStressSource)" Outputs="$(GpuStressBinary)"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="xcrun swiftc -O -target arm64-apple-macos13 -o &quot;$(GpuStressBinary)&quot; &quot;$(GpuStressSource)&quot; -framework Metal" />
  </Target>
  <Target Name="ShipGpuStress" BeforeTargets="AssignTargetPaths" AfterTargets="BuildGpuStress" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <None Include="$(GpuStressBinary)" Link="gpu-stress" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
