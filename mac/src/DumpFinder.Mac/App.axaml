<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DumpFinder.Mac"
             x:Class="DumpFinder.Mac.App"
             Name="Dump Finder"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DumpFinder/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://DumpFinder/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:IconConverter x:Key="Icon" />
      <!-- Icon · title · secondary line, separated rows inside a card -->
      <DataTemplate x:Key="InfoRowTemplate" x:DataType="local:InfoRow">
        <Border Classes="row" Classes.first="{Binding First}">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{Binding Icon, Converter={StaticResource Icon}}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <SelectableTextBlock Text="{Binding Primary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              <SelectableTextBlock Text="{Binding Secondary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,1,0,0" IsVisible="{Binding HasSecondary}" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DumpFinder/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
