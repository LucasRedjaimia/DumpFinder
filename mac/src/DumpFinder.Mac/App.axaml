<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DumpFinder.Mac"
             x:Class="DumpFinder.Mac.App"
             Name="Dump Finder"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DumpFinder/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://DumpFinder/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:IconConverter x:Key="Icon" />
      <local:IndentConverter x:Key="Indent" />
      <!-- Hardware card (Windows BuildHealthInfoCard): tag chip + title | badge, value (mono), detail,
           then "Learn more" (guide drawer) and the quick action -->
      <DataTemplate x:Key="HealthCardTemplate" x:DataType="local:HealthCardRow">
        <Border Classes="hcard" Classes.warn="{Binding IsWarn}" Classes.danger="{Binding IsDanger}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <WrapPanel VerticalAlignment="Center">
                <Border Classes="tagchip" Margin="0,0,10,0"><TextBlock Text="{Binding Tag}" /></Border>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </WrapPanel>
              <Border Grid.Column="1" Classes="badge" Classes.success="{Binding IsSuccess}" Classes.warn="{Binding IsWarn}" Classes.danger="{Binding IsDanger}" Classes.accent="{Binding IsAccent}"
                      VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBlock Text="{Binding Badge}" />
              </Border>
            </Grid>
            <SelectableTextBlock Classes="mono" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                 Margin="0,7,0,4" IsVisible="{Binding HasValue}" />
            <SelectableTextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="17" />
            <WrapPanel Margin="0,11,0,0" IsVisible="{Binding HasActions}">
              <Button Classes="flat" Content="{Binding GuideLabel}" Command="{Binding ToggleGuideCommand}" IsVisible="{Binding HasGuide}" Margin="0,0,8,0" />
              <Button Classes="flat subtle" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" CommandParameter="{Binding ActionTarget}" IsVisible="{Binding HasAction}" />
            </WrapPanel>
            <Border Background="{DynamicResource BgSubtle}" CornerRadius="8" Padding="14,12" Margin="0,10,0,0" IsVisible="{Binding GuideOpen}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding GuideTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <SelectableTextBlock Text="{Binding GuideSteps}" FontSize="12" LineHeight="18" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DumpFinder/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
