<!-- Window shell, same structure as the Windows app (src/UI/MainWindow.cs BuildLayout + MainWindow.Shell.cs):
     title bar (menu toggle, logo, "DumpFinder" wordmark, version pill), sidebar 236 / 68 px with the same
     7 sections, an elevated canvas with a rounded top-left corner, a quiet status line and bottom-right toasts. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DumpFinder.Mac"
        xmlns:core="using:DumpFinder.Mac.Core"
        xmlns:pages="using:DumpFinder.Mac.Pages"
        x:Class="DumpFinder.Mac.MainWindow"
        x:DataType="local:MainViewModel"
        Title="Dump Finder"
        Width="1240" Height="820" MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="44">

  <Window.KeyBindings>
    <KeyBinding Gesture="Cmd+D1" Command="{Binding NavigateCommand}" CommandParameter="0" />
    <KeyBinding Gesture="Cmd+D2" Command="{Binding NavigateCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Cmd+D3" Command="{Binding NavigateCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Cmd+D4" Command="{Binding NavigateCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Cmd+D5" Command="{Binding NavigateCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Cmd+D6" Command="{Binding NavigateCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Cmd+D7" Command="{Binding NavigateCommand}" CommandParameter="6" />
    <KeyBinding Gesture="Cmd+R" Command="{Binding ScanCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ScanCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Sidebar entry: indicator bar · icon · label · count badge (Windows nav row grid 4 / 26 / * / Auto) -->
    <Style Selector="Border.indicator">
      <Setter Property="Width" Value="3" /><Setter Property="Height" Value="16" /><Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-8,0,0,0" />
    </Style>
    <Style Selector="Border.navbadge">
      <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="7,1,7,2" /><Setter Property="MinWidth" Value="20" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBg}" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.navbadge > TextBlock">
      <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" /><Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- Fixes badge: count of Recommended fixes (Windows: WarnSoftBg / WarnFg) -->
    <Style Selector="Border.navbadge.warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBg}" /></Style>
    <Style Selector="Border.navbadge.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnFg}" /></Style>
  </Window.Styles>

  <Panel>
    <Grid RowDefinitions="44,*" ColumnDefinitions="Auto,*">

      <!-- ===== Title bar (traffic lights on the left, then the Windows title-bar content) =====
           The content extends into the title bar, so this area takes the clicks: dragging it moves the window and a
           double-click zooms it, as the native title bar would (OnTitleBarPressed). -->
      <Border Grid.ColumnSpan="2" Background="Transparent" PointerPressed="OnTitleBarPressed">
        <StackPanel Orientation="Horizontal" Margin="84,0,0,0" VerticalAlignment="Center">
          <Button Classes="nav" Width="40" Height="32" Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Center"
                  Command="{Binding ToggleSidebarCommand}"
                  ToolTip.Tip="{Binding L[shell.collapse_expand_menu]}" AutomationProperties.Name="{Binding L[shell.menu]}">
            <PathIcon Data="{StaticResource Icon.GlobalNav}" Width="14" Height="14" />
          </Button>
          <Image Source="{StaticResource BrandLogo}" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center" />
          <TextBlock FontSize="13" VerticalAlignment="Center">
            <Run Text="Dump" FontWeight="Bold" /><Run Text="Finder" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" />
          </TextBlock>
          <Border CornerRadius="8" Padding="6,1,6,2" Margin="9,1,0,0" VerticalAlignment="Center" Background="{DynamicResource BgSubtle}">
            <TextBlock Text="{Binding VersionBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
          </Border>
        </StackPanel>
      </Border>

      <!-- ===== Sidebar ===== -->
      <Border Grid.Row="1" Width="{Binding SidebarWidth}" Padding="12,6,12,14">
        <Grid RowDefinitions="*,Auto,Auto">
          <ScrollViewer Margin="-8,0,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,0,0">
              <Button Classes="nav" Classes.active="{Binding IsHome}" Command="{Binding NavigateCommand}" CommandParameter="0"
                      ToolTip.Tip="⌘1" AutomationProperties.Name="{Binding L[main_window.home]}" AutomationProperties.AcceleratorKey="Cmd+1">
                <Grid ColumnDefinitions="4,26,*,Auto">
                  <Border Classes="indicator" /><PathIcon Grid.Column="1" Data="{StaticResource Icon.Home}" />
                  <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding L[main_window.home]}" IsVisible="{Binding SidebarExpanded}" />
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsCrashes}" Command="{Binding NavigateCommand}" CommandParameter="1"
                      ToolTip.Tip="⌘2" AutomationProperties.Name="{Binding L[crashes.crashes]}" AutomationProperties.AcceleratorKey="Cmd+2">
                <Grid ColumnDefinitions="4,26,*,Auto">
                  <Border Classes="indicator" /><PathIcon Grid.Column="1" Data="{StaticResource Icon.Diagnostic}" />
                  <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding L[crashes.crashes]}" IsVisible="{Binding SidebarExpanded}" />
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsHardware}" Command="{Binding NavigateCommand}" CommandParameter="2"
                      ToolTip.Tip="⌘3" AutomationProperties.Name="{Binding L[main_window.hardware]}" AutomationProperties.AcceleratorKey="Cmd+3">
                <Grid ColumnDefinitions="4,26,*,Auto">
                  <Border Classes="indicator" /><PathIcon Grid.Column="1" Data="{StaticResource Icon.Component}" />
                  <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding L[main_window.hardware]}" IsVisible="{Binding SidebarExpanded}" />
                  <Border Grid.Column="3" Classes="navbadge" IsVisible="{Binding ShowHardwareBadge}">
                    <TextBlock Text="{Binding HardwareBadge}" />
                  </Border>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsFixes}" Command="{Binding NavigateCommand}" CommandParameter="3"
                      ToolTip.Tip="⌘4" AutomationProperties.Name="{Binding L[main_window.fixes]}" AutomationProperties.AcceleratorKey="Cmd+4">
                <Grid ColumnDefinitions="4,26,*,Auto">
                  <Border Classes="indicator" /><PathIcon Grid.Column="1" Data="{StaticResource Icon.Repair}" />
                  <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding L[main_window.fixes]}" IsVisible="{Binding SidebarExpanded}" />
                  <Border Grid.Column="3" Classes="navbadge warn" IsVisible="{Binding ShowFixesBadge}">
                    <TextBlock Text="{Binding FixesBadge}" />
                  </Border>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsOptimize}" Command="{Binding NavigateCommand}" CommandParameter="4"
                      ToolTip.Tip="⌘5" AutomationProperties.Name="{Binding L[main_window.optimize]}" AutomationProperties.AcceleratorKey="Cmd+5">
                <Grid ColumnDefinitions="4,26,*,Auto">
                  <Border Classes="indicator" /><PathIcon Grid.Column="1" Data="{StaticResource Icon.Speed}" />
                  <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding L[main_window.optimize]}" IsVisible="{Binding SidebarExpanded}" />
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsTools}" Command="{Binding NavigateCommand}" CommandParameter="5"
                      ToolTip.Tip="⌘6" AutomationProperties.Name="{Binding L[main_window.tools]}" AutomationProperties.AcceleratorKey="Cmd+6">
                <Grid ColumnDefinitions="4,26,*,Auto">
                  <Border Classes="indicator" /><PathIcon Grid.Column="1" Data="{StaticResource Icon.DevTools}" />
                  <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding L[main_window.tools]}" IsVisible="{Binding SidebarExpanded}" />
                </Grid>
              </Button>
            </StackPanel>
          </ScrollViewer>

          <!-- Compact hardware box (Windows: profile badge, GPU, CPU) -->
          <Border Grid.Row="1" Classes="card" CornerRadius="12" Padding="12,10" IsVisible="{Binding SidebarExpanded}">
            <StackPanel>
              <Border Classes="pill accent" CornerRadius="8" Padding="7,2,7,3" Margin="0,0,0,8">
                <TextBlock Text="{Binding HwBadge}" />
              </Border>
              <TextBlock Text="{Binding HwLine1}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding HwLine2}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
          </Border>

          <Button Grid.Row="2" Classes="nav" Classes.active="{Binding IsSettings}" Margin="0,8,0,0" Command="{Binding NavigateCommand}" CommandParameter="6"
                  ToolTip.Tip="⌘7" AutomationProperties.Name="{Binding L[main_window.settings]}" AutomationProperties.AcceleratorKey="Cmd+7">
            <Grid ColumnDefinitions="4,26,*,Auto">
              <Border Classes="indicator" /><PathIcon Grid.Column="1" Data="{StaticResource Icon.Settings}" />
              <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding L[main_window.settings]}" IsVisible="{Binding SidebarExpanded}" />
            </Grid>
          </Button>
        </Grid>
      </Border>

      <!-- ===== Canvas ===== -->
      <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource BorderCard}"
              BorderThickness="1,1,0,0" CornerRadius="12,0,0,0" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
          <Panel Margin="32,26,32,10">
            <pages:HomePage IsVisible="{Binding IsHome}" />
            <pages:CrashesPage IsVisible="{Binding IsCrashes}" />
            <pages:HardwarePage IsVisible="{Binding IsHardware}" />
            <pages:ToolsPage IsVisible="{Binding IsTools}" />
            <pages:FixesPage IsVisible="{Binding IsFixes}" />
            <pages:OptimizePage IsVisible="{Binding IsOptimize}" />
            <pages:SettingsPage IsVisible="{Binding IsSettings}" />
          </Panel>
          <!-- Quiet status line: neutral progress / last scan. Outcomes go to toasts. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="32,4,32,10">
            <Border Width="6" Height="6" CornerRadius="3" Margin="0,1,8,0" VerticalAlignment="Center" Background="{DynamicResource TextMuted}" />
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Toasts (Windows: 380 px, bottom-right, 24 / 40 px margin) ===== -->
    <ItemsControl ItemsSource="{Binding Toasts}" Width="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,40">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:ToastItem">
          <Border Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="12"
                  Padding="14,12" Margin="0,8,0,0" BoxShadow="0 8 24 0 #33000000">
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="tile" Classes.danger="{Binding IsDanger}" Classes.warn="{Binding IsWarn}" Classes.success="{Binding IsSuccess}" Width="28" Height="28">
                <PathIcon Data="{Binding Icon, Converter={StaticResource Icon}}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ===== Introduction (Windows MainWindow.Onboarding.cs: 520 px card, 3 steps, dots, Skip · Back · Next) ===== -->
    <Border Classes="scrim" IsVisible="{Binding OnboardingVisible}">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Classes="overlayshadow" />
      <Border Classes="overlaycard" Width="520" Padding="32,30,32,24">
        <StackPanel>
          <Panel Height="88" Margin="0,0,0,22">
            <Image Source="{StaticResource BrandLogo}" Width="80" Height="80" HorizontalAlignment="Left" IsVisible="{Binding IsStep1}" />
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsStep2}">
              <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBg}"><PathIcon Data="{StaticResource Icon.Document}" Width="22" Height="22" Foreground="{DynamicResource AccentText}" /></Border>
              <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBg}"><PathIcon Data="{StaticResource Icon.Diagnostic}" Width="22" Height="22" Foreground="{DynamicResource AccentText}" /></Border>
              <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBg}"><PathIcon Data="{StaticResource Icon.Component}" Width="22" Height="22" Foreground="{DynamicResource AccentText}" /></Border>
              <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBg}"><PathIcon Data="{StaticResource Icon.Shield}" Width="22" Height="22" Foreground="{DynamicResource AccentText}" /></Border>
            </StackPanel>
            <Panel Width="84" Height="84" HorizontalAlignment="Left" IsVisible="{Binding IsStep3}">
              <local:ScoreRing Value="86" StrokeWidth="8" TrackBrush="{DynamicResource BgSubtle}" FillBrush="{DynamicResource SuccessFg}" />
              <TextBlock Text="86" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Panel>
          <TextBlock Text="{Binding OnboardingKicker}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
          <TextBlock Text="{Binding OnboardingTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,6,0,10" />
          <TextBlock Text="{Binding OnboardingBody}" FontSize="14" LineHeight="21" MinHeight="84" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Classes="dot" Classes.active="{Binding IsStep1}" />
              <Border Classes="dot" Classes.active="{Binding IsStep2}" />
              <Border Classes="dot" Classes.active="{Binding IsStep3}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="link" Content="{Binding L[onboarding.skip]}" Command="{Binding OnboardingEndCommand}" IsVisible="{Binding OnboardingCanSkip}" />
              <Button Classes="flat" Content="{Binding L[onboarding.back]}" Command="{Binding OnboardingBackCommand}" IsVisible="{Binding OnboardingCanBack}" />
              <Button Classes="primary" Content="{Binding OnboardingNextText}" Command="{Binding OnboardingNextCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      </Grid>
    </Border>

    <!-- ===== New version (Windows MainWindow.Updates.cs: 580 px card, notes, GitHub · Skip · Later · Download) ===== -->
    <Border Classes="scrim" IsVisible="{Binding UpdateVisible}">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Classes="overlayshadow" />
      <Border Classes="overlaycard" Width="580" Padding="30,26,30,22">
        <StackPanel>
          <TextBlock Text="{Binding L[updates.new_version_available]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
          <TextBlock Text="{Binding UpdateTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,4" />
          <TextBlock Text="{Binding UpdateSub}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
          <Border Background="{DynamicResource BgSubtle}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
            <ScrollViewer MaxHeight="300">
              <StackPanel>
                <TextBlock Text="{Binding L[updates.no_description_for_this_release]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding UpdateNoNotes}" />
                <ItemsControl ItemsSource="{Binding UpdateNotes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:NoteLine">
                      <Panel>
                        <Border Height="6" IsVisible="{Binding Spacer}" />
                        <SelectableTextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,6,0,2" IsVisible="{Binding Heading}" />
                        <SelectableTextBlock Text="{Binding Text}" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                             Padding="{Binding Indent, Converter={StaticResource Indent}}" IsVisible="{Binding IsBody}" />
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <!-- "View on GitHub" under the notes, on its own: in the button row the four items did not fit the 580 px card in
               French or German. The buttons wrap to a second line in a longer language instead of being cut off. -->
          <Button Classes="link" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding L[updates.view_on_github]}" Command="{Binding UpdateGitHubCommand}" />
          <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0" ItemSpacing="8" LineSpacing="6">
            <Button Classes="link" Content="{Binding L[updates.skip_this_version]}" Command="{Binding UpdateSkipCommand}" />
            <Button Classes="flat" Content="{Binding L[updates.later]}" Command="{Binding UpdateLaterCommand}" />
            <Button Classes="primary" Content="{Binding UpdateDownloadText}" Command="{Binding UpdateDownloadCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      </Grid>
    </Border>

    <!-- Yes / No (Windows MessageBox), e.g. "Close Google Chrome gracefully to apply this setting?" -->
    <Border Classes="scrim" IsVisible="{Binding ConfirmVisible}">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Classes="overlayshadow" />
      <Border Classes="overlaycard" Width="440" Padding="26,22,26,18">
        <StackPanel>
          <TextBlock Text="{Binding ConfirmText}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Classes="flat" Content="{Binding L[mac.common.no]}" Command="{Binding ConfirmNoCommand}" />
            <Button Classes="primary" Content="{Binding L[mac.common.yes]}" Command="{Binding ConfirmYesCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      </Grid>
    </Border>
  </Panel>
</Window>
